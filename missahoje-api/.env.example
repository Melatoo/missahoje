# Banco usado pela API e pela CLI de migrations (npm run migration:*)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=missas_lavras

# Usuário admin criado pelo seed (npm run seed)
ADMIN_EMAIL=
ADMIN_SENHA=

# Origens que podem chamar a API pelo navegador, separadas por vírgula.
# Vazio aceita qualquer origem (dev local). Previews da Vercel não entram.
CORS_ORIGIN=

# Segredo que o servidor do front envia no header x-ssr-token. Com ele, a API
# conta o rate limit pelo IP do usuário (x-ssr-client-ip) em vez do IP do
# servidor. Mesmo valor no front.
SSR_API_TOKEN=
