# Banco usado pela API e pela CLI de migrations (npm run migration:*)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=missas_lavras

# Usuário admin criado pelo seed (npm run seed)
ADMIN_EMAIL=
ADMIN_SENHA=

# Origens que podem chamar a API pelo navegador, separadas por vírgula.
# Vazio aceita qualquer origem (dev local). Previews da Vercel não entram.
CORS_ORIGIN=
